<Project Sdk="Microsoft.NET.Sdk">

  <!-- クロスプラット: net10.0 (-windows 不要)。STA も Windows Desktop ランタイムも不要。 -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>AvSpike</RootNamespace>
    <AssemblyName>avalonia-spike</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.0.4" />
    <PackageReference Include="Avalonia.Desktop" Version="12.0.4" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.0.4" />
    <PackageReference Include="DotCL.Runtime" Version="0.1.10" GeneratePathProperty="true" />
  </ItemGroup>

  <!-- dotcl.core は DotCL.Runtime の contentFiles に copyToOutput=true が無いので
       明示コピー (paalam 本体と同じ #281 回避策)。 -->
  <ItemGroup>
    <None Include="$(PkgDotCL_Runtime)\contentFiles\any\net10.0\dotcl.core"
          Link="dotcl.core" CopyToOutputDirectory="PreserveNewest" Visible="false" />
    <Content Include="app.lisp" CopyToOutputDirectory="PreserveNewest" />
    <!-- define-class は NuGet に同梱されないので contrib を vendor 同梱。 -->
    <Content Include="vendor-dotnet-class.lisp" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
