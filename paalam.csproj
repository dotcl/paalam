<Project Sdk="Microsoft.NET.Sdk">

  <!-- Cross-platform: net10.0 (no -windows needed). GUI is Avalonia.
       Both dotcl and Avalonia come via NuGet only; no reference to the dotcl repo (#281). -->
  <PropertyGroup>
    <!-- WinExe: a GUI app, so no console window on Windows
         (effectively Exe on other OSes). boot/exceptions go to a log file. -->
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Paalam</RootNamespace>
    <AssemblyName>paalam</AssemblyName>

    <!-- Distribution binary metadata (Explorer properties etc.). The About dialog reads these
         from its own DLL (version=ProductVersion / copyright=LegalCopyright / author=CompanyName).
         License alone has no FileVersionInfo field, so it is read from paalam.asd :license.
         version is duplicated with asd :version (0.1), so keep both in sync when bumping. -->
    <Version>0.1</Version>
    <Product>paalam</Product>
    <Authors>SANO Masatoshi</Authors>
    <Company>SANO Masatoshi</Company>
    <Copyright>Copyright © 2026 SANO Masatoshi</Copyright>

    <!-- Suppress PDFtoImage's platform-annotation (CA1416) noise (only runs on supported OSes). -->
    <NoWarn>$(NoWarn);CA1416</NoWarn>
    <!-- Exclude experiments/ (spike .cs / obj etc.) from the main build. -->
    <DefaultItemExcludes>$(DefaultItemExcludes);experiments\**</DefaultItemExcludes>
    <!-- Embed the app icon in the exe (file-association DefaultIcon = exe,0 / taskbar). -->
    <ApplicationIcon>app.ico</ApplicationIcon>

    <!-- Distribution/launch (#22, dotcl #307 project-core build):
         at build time DotCL.Runtime's targets ahead-of-time compile paalam.asd's ASDF system
         in-process to a fasl, and place the dependency fasls + dotcl.core + manifest
         (dotcl-deps.txt) in the output (bin/.../dotcl-fasl/). At runtime Program.cs loads it all
         in one LoadFromManifest call -> no compile-file at startup, no source shipped.
         The hand-written precompile.lisp / <Exec dotcl> are no longer needed. -->
    <DotclProjectAsd>$(MSBuildProjectDirectory)/src/paalam.asd</DotclProjectAsd>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.0.4" />
    <PackageReference Include="Avalonia.Desktop" Version="12.0.4" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.0.4" />
    <!-- Archive reading: RAR/7z/tar etc. (pure C#, no native deps). -->
    <PackageReference Include="SharpCompress" Version="1.0.0" />
    <!-- PDF (via PDFium). bblanchon.PDFium includes the win-arm64 native binary. -->
    <PackageReference Include="PDFtoImage" Version="5.2.1" />
    <!-- EXIF/metadata extraction (pure C#, cross-platform, no native deps) (#36 Phase 2). -->
    <PackageReference Include="MetadataExtractor" Version="2.9.3" />
    <!-- HEIC/HEIF decode (pure C# via Openize.Heic, no native deps, MIT) (#13).
         SkiaSharp shares the 3.119 pulled in via PDFtoImage (compatibility verified). Decode only. -->
    <PackageReference Include="SkiaSharp.Heic" Version="0.0.1" />
    <!-- e2e: official 0.1.13 (local feed dotcl-0.1.13). Remove nuget.config once published to nuget.org. -->
    <PackageReference Include="DotCL.Runtime" Version="0.1.13" />
  </ItemGroup>

  <ItemGroup>
    <!-- Also copy app.ico to the output for the runtime Window.Icon. -->
    <Content Include="app.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

</Project>
