<Project Sdk="Microsoft.NET.Sdk">

  <!-- クロスプラット: net10.0 (-windows 不要)。GUI は Avalonia。
       dotcl/Avalonia とも NuGet 経由のみ。dotcl repo への参照は持たない (#281)。 -->
  <PropertyGroup>
    <!-- WinExe: GUI アプリなので Windows でコンソールを出さない
         (他 OS では実質 Exe 扱い)。boot/例外はログファイルに出す。 -->
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Paalam</RootNamespace>
    <AssemblyName>paalam</AssemblyName>

    <!-- 配布バイナリのメタ情報 (Explorer のプロパティ等)。About ダイアログはこれを自分の DLL から
         読む (version=ProductVersion / copyright=LegalCopyright / author=CompanyName)。
         ライセンスだけは FileVersionInfo に欄が無いので paalam.asd :license から読む。
         version は asd :version (0.1) と二重管理になるので更新時は両方そろえる。 -->
    <Version>0.1</Version>
    <Product>paalam</Product>
    <Authors>SANO Masatoshi</Authors>
    <Company>SANO Masatoshi</Company>
    <Copyright>Copyright © 2026 SANO Masatoshi</Copyright>

    <!-- PDFtoImage の platform 注釈 (CA1416) ノイズを抑制 (対応 OS 上でのみ実行)。 -->
    <NoWarn>$(NoWarn);CA1416</NoWarn>
    <!-- experiments/ 配下 (spike の .cs / obj 等) を本体ビルドから除外。 -->
    <DefaultItemExcludes>$(DefaultItemExcludes);experiments\**</DefaultItemExcludes>
    <!-- exe にアプリアイコンを埋め込み (関連付け DefaultIcon = exe,0 / タスクバー)。 -->
    <ApplicationIcon>app.ico</ApplicationIcon>

    <!-- 配布/起動 (#22, dotcl #307 project-core build):
         build 時に DotCL.Runtime の targets が paalam.asd の ASDF system を
         in-process で fasl に精コンパイルし、依存 fasl + dotcl.core + manifest
         (dotcl-deps.txt) を出力 (bin/.../dotcl-fasl/) に置く。実行時は Program.cs が
         LoadFromManifest 一発でロード → 起動時 compile-file 無し・ソース非同梱。
         手書きの precompile.lisp / <Exec dotcl> は不要になった。 -->
    <DotclProjectAsd>$(MSBuildProjectDirectory)/src/paalam.asd</DotclProjectAsd>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.0.4" />
    <PackageReference Include="Avalonia.Desktop" Version="12.0.4" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.0.4" />
    <!-- RAR/7z/tar 等の書庫読み込み (ピュア C#, ネイティブ依存なし)。 -->
    <PackageReference Include="SharpCompress" Version="1.0.0" />
    <!-- PDF (PDFium 経由)。bblanchon.PDFium が win-arm64 ネイティブを含む。 -->
    <PackageReference Include="PDFtoImage" Version="5.2.1" />
    <!-- EXIF/メタ抽出 (ピュア C#, クロスプラット, ネイティブ依存なし) (#36 Phase 2)。 -->
    <PackageReference Include="MetadataExtractor" Version="2.9.3" />
    <!-- HEIC/HEIF デコード (ピュア C# = Openize.Heic 経由, ネイティブ依存なし, MIT) (#13)。
         SkiaSharp は PDFtoImage 経由の 3.119 を共有 (互換確認済み)。decode のみ。 -->
    <PackageReference Include="SkiaSharp.Heic" Version="0.0.1" />
    <!-- e2e: 正式 0.1.13 (ローカルフィード dotcl-0.1.13)。nuget.org 公開後に nuget.config を消す。 -->
    <PackageReference Include="DotCL.Runtime" Version="0.1.13" />
  </ItemGroup>

  <ItemGroup>
    <!-- 実行時の Window.Icon 用に app.ico も出力へ。 -->
    <Content Include="app.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

</Project>
