<Project Sdk="Microsoft.NET.Sdk">

  <!-- クロスプラット: net10.0 (-windows 不要)。GUI は Avalonia。
       dotcl/Avalonia とも NuGet 経由のみ。dotcl repo への参照は持たない (#281)。 -->
  <PropertyGroup>
    <!-- WinExe: GUI アプリなので Windows でコンソールを出さない
         (他 OS では実質 Exe 扱い)。boot/例外はログファイルに出す。 -->
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Paalam</RootNamespace>
    <AssemblyName>paalam</AssemblyName>
    <!-- PDFtoImage の platform 注釈 (CA1416) ノイズを抑制 (対応 OS 上でのみ実行)。 -->
    <NoWarn>$(NoWarn);CA1416</NoWarn>
    <!-- experiments/ 配下 (spike の .cs / obj 等) を本体ビルドから除外。 -->
    <DefaultItemExcludes>$(DefaultItemExcludes);experiments\**</DefaultItemExcludes>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.0.4" />
    <PackageReference Include="Avalonia.Desktop" Version="12.0.4" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.0.4" />
    <!-- RAR/7z/tar 等の書庫読み込み (ピュア C#, ネイティブ依存なし)。 -->
    <PackageReference Include="SharpCompress" Version="1.0.0" />
    <!-- PDF (PDFium 経由)。bblanchon.PDFium が win-arm64 ネイティブを含む。 -->
    <PackageReference Include="PDFtoImage" Version="5.2.1" />
    <PackageReference Include="DotCL.Runtime" Version="0.1.10" GeneratePathProperty="true" />
  </ItemGroup>

  <!-- dotcl.core は DotCL.Runtime の contentFiles に copyToOutput=true が無いので
       明示コピー (dotcl-internal #290 の回避策)。 -->
  <ItemGroup>
    <None Include="$(PkgDotCL_Runtime)\contentFiles\any\net10.0\dotcl.core"
          Link="dotcl.core" CopyToOutputDirectory="PreserveNewest" Visible="false" />
  </ItemGroup>

  <!-- Lisp 本体と、define-class 用 contrib (NuGet に無いので vendor; #293) を出力直下へ。 -->
  <ItemGroup>
    <Content Include="src\main.lisp" Link="main.lisp">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="src\vendor-dotnet-class.lisp" Link="vendor-dotnet-class.lisp">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

</Project>
