<Project Sdk="Microsoft.NET.Sdk">

  <!-- クロスプラット: net10.0 (-windows 不要)。GUI は Avalonia。
       dotcl/Avalonia とも NuGet 経由のみ。dotcl repo への参照は持たない (#281)。 -->
  <PropertyGroup>
    <!-- WinExe: GUI アプリなので Windows でコンソールを出さない
         (他 OS では実質 Exe 扱い)。boot/例外はログファイルに出す。 -->
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Paalam</RootNamespace>
    <AssemblyName>paalam</AssemblyName>
    <!-- PDFtoImage の platform 注釈 (CA1416) ノイズを抑制 (対応 OS 上でのみ実行)。 -->
    <NoWarn>$(NoWarn);CA1416</NoWarn>
    <!-- experiments/ 配下 (spike の .cs / obj 等) を本体ビルドから除外。 -->
    <DefaultItemExcludes>$(DefaultItemExcludes);experiments\**</DefaultItemExcludes>
    <!-- exe にアプリアイコンを埋め込み (関連付け DefaultIcon = exe,0 / タスクバー)。 -->
    <ApplicationIcon>app.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.0.4" />
    <PackageReference Include="Avalonia.Desktop" Version="12.0.4" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.0.4" />
    <!-- RAR/7z/tar 等の書庫読み込み (ピュア C#, ネイティブ依存なし)。 -->
    <PackageReference Include="SharpCompress" Version="1.0.0" />
    <!-- PDF (PDFium 経由)。bblanchon.PDFium が win-arm64 ネイティブを含む。 -->
    <PackageReference Include="PDFtoImage" Version="5.2.1" />
    <!-- 0.1.11: DotCL.Runtime.targets が dotcl.core と contrib を自動で出力にコピーする
         (旧 #290/#293 の手動コピー/vendor は不要に)。 -->
    <PackageReference Include="DotCL.Runtime" Version="0.1.11" />
  </ItemGroup>

  <!-- 配布形態 (#22):
       既定 (dev) … ソース (main.lisp 等) を同梱、起動時に load (デバッグ行番号が出る)。
       -p:Precompiled=true (dist) … src/main.lisp を 1 個の paalam.fasl に精コンパイルして
         それだけ同梱 (起動が速い・ソース非平文)。精コンパイルは build 時にインストール済み
         dotcl で実行 (実行時ランタイムは NuGet)。 -->
  <PropertyGroup>
    <Precompiled Condition="'$(Precompiled)' == ''">false</Precompiled>
    <DotclExe Condition="'$(DotclExe)' == ''">dotcl</DotclExe>
  </PropertyGroup>

  <!-- dev: 出力に残った古い paalam.fasl を消す (dist→dev で fasl が残り source に戻らないのを防ぐ)。 -->
  <Target Name="RemoveStaleFasl" BeforeTargets="Build" Condition="'$(Precompiled)' != 'true'">
    <Delete Files="$(OutDir)paalam.fasl" />
  </Target>

  <!-- dev: ソース群 + asd を glob コピー (個別列挙せず asd :components と二重管理にしない)。 -->
  <ItemGroup Condition="'$(Precompiled)' != 'true'">
    <Content Include="src\*.lisp" Link="%(Filename)%(Extension)">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="src\paalam.asd" Link="paalam.asd">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <!-- dist: precompile.lisp で main.lisp -> paalam.fasl (incremental)、build 後に出力へコピー。
       Content+CopyToOutputDirectory だと fasl 生成前にコピーが走るので、明示 Copy + DependsOn で
       順序を保証する (PrecompiledLispDemo と同パターン)。 -->
  <Target Name="PrecompilePaalam" Condition="'$(Precompiled)' == 'true'"
          Inputs="src/main.lisp;precompile.lisp" Outputs="paalam.fasl">
    <Exec WorkingDirectory="$(MSBuildProjectDirectory)" Command="$(DotclExe) precompile.lisp" />
  </Target>
  <Target Name="CopyPaalamFasl" AfterTargets="Build" DependsOnTargets="PrecompilePaalam"
          Condition="'$(Precompiled)' == 'true'">
    <Copy SourceFiles="$(MSBuildProjectDirectory)/paalam.fasl" DestinationFolder="$(OutDir)"
          SkipUnchangedFiles="true" />
  </Target>

  <ItemGroup>
    <!-- 実行時の Window.Icon 用に app.ico も出力へ。 -->
    <Content Include="app.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

</Project>
