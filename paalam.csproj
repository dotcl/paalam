<Project Sdk="Microsoft.NET.Sdk">

  <!-- クロスプラット: net10.0 (-windows 不要)。GUI は Avalonia。
       dotcl/Avalonia とも NuGet 経由のみ。dotcl repo への参照は持たない (#281)。 -->
  <PropertyGroup>
    <!-- WinExe: GUI アプリなので Windows でコンソールを出さない
         (他 OS では実質 Exe 扱い)。boot/例外はログファイルに出す。 -->
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Paalam</RootNamespace>
    <AssemblyName>paalam</AssemblyName>
    <!-- PDFtoImage の platform 注釈 (CA1416) ノイズを抑制 (対応 OS 上でのみ実行)。 -->
    <NoWarn>$(NoWarn);CA1416</NoWarn>
    <!-- experiments/ 配下 (spike の .cs / obj 等) を本体ビルドから除外。 -->
    <DefaultItemExcludes>$(DefaultItemExcludes);experiments\**</DefaultItemExcludes>
    <!-- exe にアプリアイコンを埋め込み (関連付け DefaultIcon = exe,0 / タスクバー)。 -->
    <ApplicationIcon>app.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.0.4" />
    <PackageReference Include="Avalonia.Desktop" Version="12.0.4" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.0.4" />
    <!-- RAR/7z/tar 等の書庫読み込み (ピュア C#, ネイティブ依存なし)。 -->
    <PackageReference Include="SharpCompress" Version="1.0.0" />
    <!-- PDF (PDFium 経由)。bblanchon.PDFium が win-arm64 ネイティブを含む。 -->
    <PackageReference Include="PDFtoImage" Version="5.2.1" />
    <!-- 0.1.11: DotCL.Runtime.targets が dotcl.core と contrib を自動で出力にコピーする
         (旧 #290/#293 の手動コピー/vendor は不要に)。 -->
    <PackageReference Include="DotCL.Runtime" Version="0.1.11" />
  </ItemGroup>

  <!-- Lisp 本体を出力直下へ (contrib は require が NuGet 同梱から解決)。 -->
  <ItemGroup>
    <Content Include="src\main.lisp" Link="main.lisp">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <!-- 実行時の Window.Icon 用に app.ico も出力へ。 -->
    <Content Include="app.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

</Project>
